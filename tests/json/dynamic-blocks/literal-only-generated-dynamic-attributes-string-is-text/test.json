{
  "description": "In literal-only mode, dynamic attributes processing of a generated block gives strings as text",
  "spec": [
    "ext/dynblock/README.md#usage",
    "spec.md#expression-evaluation",
    "json/spec.md#strings",
    "spec.md#dynamic-attributes-processing"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "dynamic-blocks"
  ],
  "evaluation_mode": "literal-only",
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "dynamic-attributes"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "string": "${b.value}"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
