{
  "description": "A for_each string without a template sequence is an error, even a variable's name",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "json/spec.md#strings"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "dynamic-blocks"
  ],
  "variables": {
    "xs": {
      "tuple": [
        {
          "string": "x"
        }
      ]
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "reference_error": "Cannot use a string value in for_each",
  "expect": {
    "valid": false,
    "phase": "schema"
  }
}
