{
  "description": "A property other than a dynamic block's own is an error in its body",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "json/spec.md#structural-elements"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            },
            {
              "name": "other"
            }
          ]
        }
      }
    ]
  },
  "reference_error": "No argument or block type is named \"other\"",
  "expect": {
    "valid": false,
    "phase": "schema"
  }
}
