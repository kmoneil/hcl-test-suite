{
  "description": "Newlines inside a type constructor call in a JSON string are ignored",
  "spec": [
    "ext/typeexpr/README.md#hcl-type-expressions-extension",
    "hclsyntax/spec.md#functions-and-function-calls"
  ],
  "op": "decode",
  "features": [
    "typed-values",
    "json-syntax",
    "static-analysis",
    "type-expressions"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "type"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "type": [
            "list",
            "string"
          ]
        }
      },
      "blocks": []
    }
  }
}
