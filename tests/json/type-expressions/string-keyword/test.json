{
  "description": "A JSON string containing a type keyword is that type",
  "spec": [
    "ext/typeexpr/README.md#hcl-type-expressions-extension",
    "json/spec.md#strings"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis",
    "type-expressions"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "type"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "type": "string"
        }
      },
      "blocks": []
    }
  }
}
