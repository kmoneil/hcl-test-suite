{
  "description": "A required attribute without a property is an error",
  "spec": [
    "spec.md#schema-driven-processing",
    "json/spec.md#attributes"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "required": true
      },
      {
        "name": "b"
      }
    ]
  },
  "reference_error": "The argument \"a\" is required",
  "expect": {
    "valid": false,
    "phase": "schema"
  }
}
