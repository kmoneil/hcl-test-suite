{
  "description": "A property named // in a block body is ignored",
  "spec": [
    "json/spec.md#structural-elements"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "x"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "x": {
                "number": "1"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
