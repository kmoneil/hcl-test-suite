{
  "description": "A property defined twice is no error when partial processing doesn't take it",
  "spec": [
    "spec.md#partial-processing-of-body-content",
    "json/spec.md#attributes"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "partial",
    "attributes": [
      {
        "name": "a"
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "number": "1"
        }
      },
      "blocks": []
    }
  }
}
