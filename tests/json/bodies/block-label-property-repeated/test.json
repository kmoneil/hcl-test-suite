{
  "description": "A property repeated at a label level defines separate blocks with the same label",
  "spec": [
    "json/spec.md#blocks"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "labels": [
          "name"
        ],
        "body": {
          "mode": "dynamic-attributes"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [
            "l"
          ],
          "body": {
            "attributes": {
              "x": {
                "number": "1"
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [
            "l"
          ],
          "body": {
            "attributes": {
              "x": {
                "number": "2"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
