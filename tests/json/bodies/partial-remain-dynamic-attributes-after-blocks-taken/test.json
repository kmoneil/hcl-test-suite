{
  "description": "Dynamic attributes processing of a remaining body ignores the blocks already taken",
  "spec": [
    "spec.md#partial-processing-of-body-content",
    "spec.md#dynamic-attributes-processing"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "partial",
    "attributes": [
      {
        "name": "a"
      }
    ],
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "dynamic-attributes"
        }
      }
    ],
    "remain": {
      "mode": "dynamic-attributes"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "number": "1"
        }
      },
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": []
          }
        }
      ],
      "remain": {
        "attributes": {
          "c": {
            "number": "2"
          }
        },
        "blocks": []
      }
    }
  }
}
