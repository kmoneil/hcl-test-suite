{
  "description": "An optional attribute without a property is not in the body content",
  "spec": [
    "spec.md#schema-driven-processing",
    "json/spec.md#attributes"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a"
      },
      {
        "name": "b"
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "number": "1"
        }
      },
      "blocks": []
    }
  }
}
