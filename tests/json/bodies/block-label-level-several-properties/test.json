{
  "description": "Several properties at a label level define blocks with different labels, in order",
  "spec": [
    "json/spec.md#blocks"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "labels": [
          "one",
          "two"
        ],
        "body": {
          "mode": "dynamic-attributes"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [
            "l",
            "m"
          ],
          "body": {
            "attributes": {
              "x": {
                "number": "1"
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [
            "l",
            "n"
          ],
          "body": {
            "attributes": {
              "x": {
                "number": "2"
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [
            "k",
            "m"
          ],
          "body": {
            "attributes": {
              "x": {
                "number": "3"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
