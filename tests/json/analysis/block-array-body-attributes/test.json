{
  "description": "An attribute in each block of a JSON block array is analyzed separately",
  "spec": [
    "json/spec.md#static-analysis",
    "json/spec.md#blocks"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "c",
              "analysis": {
                "kind": "static-list",
                "elements": {
                  "kind": "static-traversal"
                }
              }
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "c": {
                "static_list": [
                  {
                    "static_traversal": [
                      {
                        "root": "x"
                      }
                    ]
                  }
                ]
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "c": {
                "static_list": [
                  {
                    "static_traversal": [
                      {
                        "root": "y"
                      },
                      {
                        "attr": "z"
                      }
                    ]
                  }
                ]
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
