{
  "description": "JSON static map values can be analyzed as static calls",
  "spec": [
    "json/spec.md#static-map",
    "json/spec.md#static-call"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-map",
          "values": {
            "kind": "static-call"
          }
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_map": [
            {
              "key": {
                "string": "b"
              },
              "value": {
                "static_call": {
                  "name": "f",
                  "arguments": [
                    {
                      "number": "1"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
