{
  "description": "A JSON string containing true analyzed as a static traversal gives the root true",
  "spec": [
    "json/spec.md#static-traversal",
    "hclsyntax/spec.md#static-traversal"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-traversal"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_traversal": [
            {
              "root": "true"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
