{
  "description": "A JSON string containing a call without arguments gives a static call without arguments",
  "spec": [
    "json/spec.md#static-call"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-call"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_call": {
            "name": "f",
            "arguments": []
          }
        }
      },
      "blocks": []
    }
  }
}
