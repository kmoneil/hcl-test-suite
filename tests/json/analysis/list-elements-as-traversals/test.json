{
  "description": "JSON static list elements can be analyzed as static traversals",
  "spec": [
    "json/spec.md#static-list",
    "json/spec.md#static-traversal"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-list",
          "elements": {
            "kind": "static-traversal"
          }
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_list": [
            {
              "static_traversal": [
                {
                  "root": "x"
                },
                {
                  "attr": "y"
                }
              ]
            },
            {
              "static_traversal": [
                {
                  "root": "z"
                },
                {
                  "index": {
                    "number": "0"
                  }
                }
              ]
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
