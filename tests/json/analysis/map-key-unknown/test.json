{
  "description": "A static map key template giving an unknown string is an unknown string key",
  "spec": [
    "json/spec.md#static-map",
    "json/spec.md#strings"
  ],
  "op": "decode",
  "features": [
    "typed-values",
    "unknown-values",
    "json-syntax",
    "static-analysis"
  ],
  "variables": {
    "u": {
      "unknown": "string"
    }
  },
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-map"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_map": [
            {
              "key": {
                "unknown": "string"
              },
              "value": {
                "number": "1"
              }
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
