{
  "description": "In literal-only mode a static list element string is its exact text",
  "spec": [
    "json/spec.md#static-list",
    "json/spec.md#strings"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis"
  ],
  "evaluation_mode": "literal-only",
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-list"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_list": [
            {
              "string": "${x}"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
