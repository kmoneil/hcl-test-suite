{
  "description": "A heredoc argument in a JSON static call is a native template",
  "spec": [
    "json/spec.md#static-call",
    "hclsyntax/spec.md#template-expressions"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-call"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_call": {
            "name": "f",
            "arguments": [
              {
                "string": "hi\n"
              }
            ]
          }
        }
      },
      "blocks": []
    }
  }
}
