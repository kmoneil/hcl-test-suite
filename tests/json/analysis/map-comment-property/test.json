{
  "description": "A property named // in a JSON static map is a pair",
  "spec": [
    "json/spec.md#static-map",
    "json/spec.md#structural-elements"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-map"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_map": [
            {
              "key": {
                "string": "//"
              },
              "value": {
                "number": "1"
              }
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
