{
  "description": "A JSON array analyzed as a static list gives an expression for each element in order",
  "spec": [
    "json/spec.md#static-list"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-list"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_list": [
            {
              "number": "1"
            },
            {
              "string": "x"
            },
            {
              "number": "2"
            },
            {
              "tuple": [
                {
                  "number": "2"
                }
              ]
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
