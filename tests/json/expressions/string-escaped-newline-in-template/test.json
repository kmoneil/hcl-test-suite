{
  "description": "A \\n escape is a newline in the template text",
  "spec": [
    "json/spec.md#strings",
    "json/spec.md#hcl-json-syntax-specification"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "dynamic-attributes"
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "string": "x\n1"
        }
      },
      "blocks": []
    }
  }
}
