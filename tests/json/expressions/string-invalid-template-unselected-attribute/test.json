{
  "description": "A string that isn't a valid template is no error when its attribute isn't evaluated",
  "spec": [
    "json/spec.md#strings",
    "spec.md#partial-processing-of-body-content"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "partial",
    "attributes": [
      {
        "name": "a"
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "number": "1"
        }
      },
      "blocks": []
    }
  }
}
