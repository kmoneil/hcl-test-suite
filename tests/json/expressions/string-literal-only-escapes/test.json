{
  "description": "In literal-only mode, $${ and %%{ are left as written",
  "spec": [
    "json/spec.md#strings",
    "spec.md#expression-evaluation"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "evaluation_mode": "literal-only",
  "schema": {
    "mode": "dynamic-attributes"
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "string": "$${x} %%{y}"
        }
      },
      "blocks": []
    }
  }
}
