{
  "description": "Array elements can be arrays and objects",
  "spec": [
    "json/spec.md#arrays"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "dynamic-attributes"
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "tuple": [
            {
              "tuple": [
                {
                  "number": "1"
                }
              ]
            },
            {
              "object": {
                "b": {
                  "tuple": [
                    {
                      "number": "2"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
