{
  "description": "An escaped interpolation followed by a tilde in a JSON string template is literal text",
  "spec": [
    "json/spec.md#strings",
    "hclsyntax/spec.md#template-literals"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "dynamic-attributes"
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "string": "${~x}"
        }
      },
      "blocks": []
    }
  }
}
