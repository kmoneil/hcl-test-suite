{
  "description": "An escaped quote inside an interpolation quotes a native string",
  "spec": [
    "json/spec.md#strings",
    "json/spec.md#hcl-json-syntax-specification"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "dynamic-attributes"
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "string": "x"
        }
      },
      "blocks": []
    }
  }
}
