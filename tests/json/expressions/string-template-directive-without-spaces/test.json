{
  "description": "A directive needs no spaces around its keyword in a JSON string template",
  "spec": [
    "json/spec.md#strings",
    "hclsyntax/spec.md#template-if-directive"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "dynamic-attributes"
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "string": "x"
        }
      },
      "blocks": []
    }
  }
}
