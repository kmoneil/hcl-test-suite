{
  "description": "A property name can interpolate an expression into the attribute name",
  "spec": [
    "json/spec.md#objects",
    "json/spec.md#strings"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "schema": {
    "mode": "dynamic-attributes"
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "object": {
            "b": {
              "number": "1"
            }
          }
        }
      },
      "blocks": []
    }
  }
}
