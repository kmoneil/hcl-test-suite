{
  "description": "A result array is a tuple whose elements are evaluated with the parameters",
  "spec": [
    "ext/userfunc/README.md#hcl-user-functions-extension",
    "json/spec.md#expressions"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "user-functions"
  ],
  "user_functions": "function",
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a"
      }
    ]
