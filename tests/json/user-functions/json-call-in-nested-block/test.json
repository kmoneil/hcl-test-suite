{
  "description": "In the JSON syntax a nested block's attribute can call a function",
  "spec": [
    "ext/userfunc/README.md#hcl-user-functions-extension",
    "json/spec.md#blocks"
  ],
  "op": "decode",
  "features": [
    "json-syntax",
    "user-functions"
  ],
  "user_functions": "function",
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "c"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "c": {
                "number": "1"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
