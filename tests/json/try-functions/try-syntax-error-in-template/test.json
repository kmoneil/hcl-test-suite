{
  "description": "A syntax error in try's arguments in a JSON string template is an evaluation error",
  "spec": [
    "ext/tryfunc/README.md#try-and-can-functions",
    "json/spec.md#strings"
  ],
  "op": "decode",
  "features": [
    "functions",
    "json-syntax",
    "try-functions"
  ],
  "functions": {
    "try": {
      "extension": "try"
    }
  },
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a"
      }
    ]
  },
  "reference_error": "Expected the start of an expression, but found an invalid expression token",
  "expect": {
    "valid": false,
    "phase": "eval"
  }
}
