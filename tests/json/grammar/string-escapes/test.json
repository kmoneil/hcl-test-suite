{
  "description": "The two-character escapes stand for their characters",
  "spec": [
    "json/spec.md#hcl-json-syntax-specification",
    "json/spec.md#strings"
  ],
  "op": "decode",
  "features": [
    "json-syntax"
  ],
  "evaluation_mode": "literal-only",
  "schema": {
    "mode": "dynamic-attributes"
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "string": "\" \\ / \b \f \n \r \t"
        }
      },
      "blocks": []
    }
  }
}
