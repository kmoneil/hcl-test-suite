{
  "description": "Accepting the dynamic pseudo-type but not unknowns gives an unknown of the function's result type",
  "spec": [
    "spec.md#functions-and-function-calls",
    "spec.md#unknown-values-and-the-dynamic-pseudo-type"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "unknown-values",
    "functions"
  ],
  "variables": {
    "d": {
      "unknown": "dynamic"
    }
  },
  "functions": {
    "f": {
      "params": [
        {
          "type": "dynamic",
          "allow_dynamic_type": true
        }
      ],
      "result": {
        "value": {
          "string": "x"
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "unknown": "string"
        }
      },
      "blocks": []
    }
  }
}
