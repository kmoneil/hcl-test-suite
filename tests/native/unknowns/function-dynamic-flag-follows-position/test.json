{
  "description": "The dynamic value forces a dynamic result when its own parameter doesn't accept that type",
  "spec": [
    "spec.md#functions-and-function-calls",
    "spec.md#unknown-values-and-the-dynamic-pseudo-type"
  ],
  "op": "eval",
  "features": [
    "unknown-values",
    "functions"
  ],
  "variables": {
    "d": {
      "unknown": "dynamic"
    }
  },
  "functions": {
    "f": {
      "params": [
        {
          "type": "dynamic",
          "allow_dynamic_type": true
        },
        {
          "type": "dynamic"
        }
      ],
      "result": "arguments"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "unknown": "dynamic"
        }
      },
      "blocks": []
    }
  }
}
