{
  "description": "A legacy index in a static traversal gives an index step, not an attribute step",
  "spec": [
    "hclsyntax/spec.md#static-traversal",
    "hclsyntax/spec.md#index-operator"
  ],
  "op": "decode",
  "features": [
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-traversal"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_traversal": [
            {
              "root": "x"
            },
            {
              "index": {
                "number": "0"
              }
            },
            {
              "attr": "y"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
