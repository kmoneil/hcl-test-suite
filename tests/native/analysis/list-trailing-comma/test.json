{
  "description": "A trailing comma in a tuple constructor doesn't add an element to its static list",
  "spec": [
    "hclsyntax/spec.md#static-list"
  ],
  "op": "decode",
  "features": [
    "static-analysis"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "static-list"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "static_list": [
            {
              "number": "1"
            },
            {
              "number": "2"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
