{
  "description": "A call's result can be interpolated into a template",
  "spec": [
    "hclsyntax/spec.md#functions-and-function-calls",
    "hclsyntax/spec.md#template-interpolations"
  ],
  "op": "eval",
  "features": [
    "functions"
  ],
  "functions": {
    "f": {
      "result": {
        "value": {
          "string": "x"
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "string": "<x>"
        }
      },
      "blocks": []
    }
  }
}
