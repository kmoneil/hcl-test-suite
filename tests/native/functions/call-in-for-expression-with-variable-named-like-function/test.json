    "hclsyntax/spec.md#functions-and-function-calls",
    "hclsyntax/spec.md#for-expressions"
  ],
  "op": "eval",
  "features": [
    "functions"
  ],
  "functions": {
    "f": {
      "params": [
        {
          "type": "string"
        }
      ],
      "result": "arguments"
