{
  "description": "An index with a variable key directly after an attribute-only splat applies to the splat's result",
  "spec": [
    "hclsyntax/spec.md#splat-operators",
    "hclsyntax/spec.md#index-operator"
  ],
  "op": "parse",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "kind": "index",
          "collection": {
            "kind": "splat",
            "source": {
              "kind": "variable",
              "name": "t"
            },
            "each": {
              "kind": "splat_item"
            }
          },
          "key": {
            "kind": "variable",
            "name": "i"
          }
        }
      },
      "blocks": []
    }
  }
}
