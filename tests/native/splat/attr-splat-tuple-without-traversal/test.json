{
  "description": "An attribute-only splat with nothing after it gives a tuple of the same elements",
  "spec": [
    "hclsyntax/spec.md#splat-operators"
  ],
  "op": "eval",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "tuple": [
            {
              "number": "1"
            },
            {
              "number": "2"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
