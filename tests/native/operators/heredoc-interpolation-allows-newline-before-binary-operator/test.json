                  "kind": "variable",
                  "name": "x"
                },
                "right": {
                  "kind": "literal",
                  "value": {
                    "number": "1"
                  }
                }
              }
            },
            {
              "kind": "literal",
              "value": {
                "string": "\n"
              }
            }
          ]
        }
      },
      "blocks": []
    }
