{
  "description": "A bare key containing a dash is one identifier, not a subtraction",
  "spec": [
    "hclsyntax/spec.md#collection-values",
    "hclsyntax/spec.md#identifiers"
  ],
  "op": "eval",
  "notes": "Identifiers can contain dashes, so b-c is a single identifier token.",
  "variables": {
    "b": {
      "number": "3"
    },
    "c": {
      "number": "1"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "object": {
            "b-c": {
              "number": "1"
            }
          }
        }
      },
      "blocks": []
    }
  }
}
