{
  "description": "A bare identifier key names the attribute even when a variable has that name",
  "spec": [
    "hclsyntax/spec.md#collection-values"
  ],
  "op": "eval",
  "variables": {
    "foo": {
      "string": "x"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "object": {
            "foo": {
              "string": "baz"
            }
          }
        }
      },
      "blocks": []
    }
  }
}
