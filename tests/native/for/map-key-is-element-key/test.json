{
  "description": "For a map, the key variable holds the element key and the value variable the element",
  "spec": [
    "hclsyntax/spec.md#for-expressions",
    "spec.md#collection-types"
  ],
  "op": "eval",
  "features": [
    "typed-values"
  ],
  "variables": {
    "m": {
      "map": {
        "x": {
          "number": "1"
        }
      },
      "element_type": "number"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "tuple": [
            {
              "tuple": [
                {
                  "string": "x"
                },
                {
                  "number": "1"
                }
              ]
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
