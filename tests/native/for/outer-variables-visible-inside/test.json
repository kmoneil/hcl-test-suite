{
  "description": "Outer variables with other names are visible inside a for expression",
  "spec": [
    "hclsyntax/spec.md#for-expressions",
    "hclsyntax/spec.md#variables-and-variable-expressions"
  ],
  "op": "eval",
  "variables": {
    "x": {
      "string": "outer"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "tuple": [
            {
              "string": "outer"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
