{
  "description": "With one variable, iterating a set binds each element",
  "spec": [
    "hclsyntax/spec.md#for-expressions",
    "spec.md#collection-types"
  ],
  "op": "eval",
  "features": [
    "typed-values"
  ],
  "variables": {
    "s": {
      "set": [
        {
          "string": "x"
        }
      ],
      "element_type": "string"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "tuple": [
            {
              "string": "x"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
