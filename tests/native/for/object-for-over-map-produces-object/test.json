{
  "description": "An object for expression over a map produces an object, not a map",
  "spec": [
    "hclsyntax/spec.md#for-expressions",
    "spec.md#collection-types"
  ],
  "op": "eval",
  "features": [
    "typed-values"
  ],
  "variables": {
    "m": {
      "map": {
        "x": {
          "number": "1"
        },
        "y": {
          "number": "2"
        }
      },
      "element_type": "number"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "object": {
            "x": {
              "number": "1"
            },
            "y": {
              "number": "2"
            }
          }
        }
      },
      "blocks": []
    }
  }
}
