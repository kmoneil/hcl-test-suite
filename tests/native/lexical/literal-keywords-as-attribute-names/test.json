{
  "description": "The keywords true, false and null can be attribute names",
  "spec": [
    "hclsyntax/spec.md#keywords",
    "hclsyntax/spec.md#attribute-definitions"
  ],
  "op": "parse",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "true": {
          "kind": "literal",
          "value": {
            "number": "1"
          }
        },
        "false": {
          "kind": "literal",
          "value": {
            "number": "2"
          }
        },
        "null": {
          "kind": "literal",
          "value": {
            "number": "3"
          }
        }
      },
      "blocks": []
    }
  }
}
