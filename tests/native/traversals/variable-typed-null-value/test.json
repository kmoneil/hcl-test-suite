{
  "description": "A variable holding a null list evaluates to null of the list type",
  "spec": [
    "hclsyntax/spec.md#variables-and-variable-expressions",
    "spec.md#null-values"
  ],
  "op": "eval",
  "features": [
    "typed-values"
  ],
  "variables": {
    "v": {
      "null": [
        "list",
        "string"
      ]
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "null": [
            "list",
            "string"
          ]
        }
      },
      "blocks": []
    }
  }
}
