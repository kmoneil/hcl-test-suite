{
  "description": "An identifier named endif is an ordinary variable reference outside template directives",
  "spec": [
    "hclsyntax/spec.md#variables-and-variable-expressions",
    "hclsyntax/spec.md#keywords"
  ],
  "op": "eval",
  "variables": {
    "endif": {
      "string": "value"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "string": "value"
        }
      },
      "blocks": []
    }
  }
}
