{
  "description": "A variable holding a map evaluates to a map with the same element type",
  "spec": [
    "hclsyntax/spec.md#variables-and-variable-expressions",
    "spec.md#collection-types"
  ],
  "op": "eval",
  "features": [
    "typed-values"
  ],
  "variables": {
    "m": {
      "map": {
        "k": {
          "string": "v"
        }
      },
      "element_type": "string"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "map": {
            "k": {
              "string": "v"
            }
          },
          "element_type": "string"
        }
      },
      "blocks": []
    }
  }
}
