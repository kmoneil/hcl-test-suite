{
  "description": "A variable holding a set evaluates to a set with the same elements and element type",
  "spec": [
    "hclsyntax/spec.md#variables-and-variable-expressions",
    "spec.md#collection-types"
  ],
  "op": "eval",
  "features": [
    "typed-values"
  ],
  "variables": {
    "s": {
      "set": [
        {
          "string": "x"
        },
        {
          "string": "y"
        }
      ],
      "element_type": "string"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "set": [
            {
              "string": "x"
            },
            {
              "string": "y"
            }
          ],
          "element_type": "string"
        }
      },
      "blocks": []
    }
  }
}
