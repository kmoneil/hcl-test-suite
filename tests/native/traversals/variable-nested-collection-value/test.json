{
  "description": "A variable holding a map of lists keeps the collection types at every level",
  "spec": [
    "hclsyntax/spec.md#variables-and-variable-expressions",
    "spec.md#collection-types"
  ],
  "op": "eval",
  "features": [
    "typed-values"
  ],
  "variables": {
    "m": {
      "map": {
        "k": {
          "list": [
            {
              "number": "1"
            }
          ],
          "element_type": "number"
        }
      },
      "element_type": [
        "list",
        "number"
      ]
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "map": {
            "k": {
              "list": [
                {
                  "number": "1"
                }
              ],
              "element_type": "number"
            }
          },
          "element_type": [
            "list",
            "number"
          ]
        }
      },
      "blocks": []
    }
  }
}
