{
  "description": "In literal-only mode function blocks are still taken from the body",
  "spec": [
    "ext/userfunc/README.md#hcl-user-functions-extension",
    "spec.md#schema-driven-processing"
  ],
  "op": "decode",
  "features": [
    "user-functions"
  ],
  "evaluation_mode": "literal-only",
  "user_functions": "function",
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a"
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "number": "2"
        }
      },
      "blocks": []
    }
  }
}
