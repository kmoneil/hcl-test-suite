{
  "description": "Schema-driven processing of what remains doesn't see the function blocks",
  "spec": [
    "ext/userfunc/README.md#hcl-user-functions-extension",
    "spec.md#schema-driven-processing"
  ],
  "op": "decode",
  "features": [
    "user-functions"
  ],
  "user_functions": "function",
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a"
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "number": "2"
        }
      },
      "blocks": []
    }
  }
}
