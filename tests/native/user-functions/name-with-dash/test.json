{
  "description": "A function name can contain a dash, as identifiers can",
  "spec": [
    "ext/userfunc/README.md#hcl-user-functions-extension",
    "hclsyntax/spec.md#identifiers"
  ],
  "op": "decode",
  "features": [
    "user-functions"
  ],
  "user_functions": "function",
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a"
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "number": "1"
        }
      },
      "blocks": []
    }
  }
}
