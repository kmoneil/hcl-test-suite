{
  "description": "A block body can be processed as dynamic attributes",
  "spec": [
    "spec.md#dynamic-attributes-processing",
    "spec.md#schema-driven-processing"
  ],
  "op": "decode",
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "dynamic-attributes"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "x": {
                "number": "1"
              },
              "y": {
                "number": "2"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
