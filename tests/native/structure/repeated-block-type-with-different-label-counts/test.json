{
  "description": "Blocks of the same type can have different numbers of labels",
  "spec": [
    "hclsyntax/spec.md#blocks",
    "spec.md#structural-elements"
  ],
  "op": "parse",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "block",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": []
          }
        },
        {
          "type": "block",
          "labels": [
            "x"
          ],
          "body": {
            "attributes": {},
            "blocks": []
          }
        },
        {
          "type": "block",
          "labels": [
            "x",
            "y"
          ],
          "body": {
            "attributes": {},
            "blocks": []
          }
        }
      ]
    }
  }
}
