{
  "description": "A body can contain attributes and blocks in any order",
  "spec": [
    "hclsyntax/spec.md#bodies",
    "hclsyntax/spec.md#structural-elements"
  ],
  "op": "parse",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "kind": "literal",
          "value": {
            "number": "1"
          }
        },
        "c": {
          "kind": "literal",
          "value": {
            "number": "2"
          }
        }
      },
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": []
          }
        },
        {
          "type": "d",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": []
          }
        }
      ]
    }
  }
}
