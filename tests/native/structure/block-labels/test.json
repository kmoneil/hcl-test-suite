{
  "description": "Block labels can be quoted strings or bare identifiers",
  "spec": [
    "hclsyntax/spec.md#blocks"
  ],
  "op": "parse",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "resource",
          "labels": [
            "aws_instance",
            "web"
          ],
          "body": {
            "attributes": {
              "ami": {
                "kind": "literal",
                "value": {
                  "string": "ami-123"
                }
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
