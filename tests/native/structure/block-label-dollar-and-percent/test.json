{
  "description": "A $ or % that does not start a template sequence is literal text in a quoted block label",
  "spec": [
    "hclsyntax/spec.md#blocks",
    "hclsyntax/spec.md#template-expressions"
  ],
  "op": "parse",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "block",
          "labels": [
            "$x%"
          ],
          "body": {
            "attributes": {},
            "blocks": []
          }
        }
      ]
    }
  }
}
