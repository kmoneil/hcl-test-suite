{
  "description": "A block's body can define an attribute name that its parent body also defines",
  "spec": [
    "hclsyntax/spec.md#attribute-definitions",
    "spec.md#structural-elements"
  ],
  "op": "parse",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "kind": "literal",
          "value": {
            "number": "1"
          }
        }
      },
      "blocks": [
        {
          "type": "block",
          "labels": [],
          "body": {
            "attributes": {
              "a": {
                "kind": "literal",
                "value": {
                  "number": "2"
                }
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
