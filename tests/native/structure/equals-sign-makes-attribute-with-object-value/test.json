{
  "description": "A name followed by an equals sign and braces is an attribute with an object value, not a block",
  "spec": [
    "hclsyntax/spec.md#structural-elements",
    "hclsyntax/spec.md#collection-values"
  ],
  "op": "parse",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "kind": "object",
          "items": [
            {
              "key": {
                "kind": "literal",
                "value": {
                  "string": "b"
                }
              },
              "value": {
                "kind": "literal",
                "value": {
                  "number": "1"
                }
              }
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
