{
  "description": "A body's blocks keep their source order",
  "spec": [
    "spec.md#schema-driven-processing",
    "hclsyntax/spec.md#blocks"
  ],
  "op": "parse",
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": []
          }
        },
        {
          "type": "a",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": []
          }
        }
      ]
    }
  }
}
