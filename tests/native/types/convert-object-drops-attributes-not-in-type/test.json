{
  "description": "Converting an object to an object type drops the attributes the type lacks",
  "spec": [
    "spec.md#collection-and-structural-type-conversions",
    "ext/typeexpr/README.md#the-convert-cty-function"
  ],
  "op": "eval",
  "features": [
    "functions",
    "type-expressions"
  ],
  "functions": {
    "convert": {
      "extension": "convert"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "object": {
            "z": {
              "number": "2"
            }
          }
        }
      },
      "blocks": []
    }
  }
}
