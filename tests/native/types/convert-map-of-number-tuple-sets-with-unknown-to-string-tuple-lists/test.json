      "map": {
        "x": {
          "set": [],
          "element_type": [
            "tuple",
            [
              "number"
            ]
          ]
        },
        "y": {
          "set": [
            {
              "unknown": [
                "tuple",
                [
                  "number"
                ]
              ]
            },
            {
              "tuple": [
                {
                  "number": "2"
                }
              ]
            }
          ],
          "element_type": [
            "tuple",
            [
              "number"
            ]
          ]
        }
      },
      "element_type": [
        "set",
        [
          "tuple",
          [
            "number"
          ]
        ]
      ]
    }
  },
  "functions": {
    "convert": {
      "extension": "convert"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "map": {
            "x": {
              "list": [],
              "element_type": [
                "tuple",
                [
                  "string"
                ]
              ]
            },
            "y": {
              "unknown": [
                "list",
                [
                  "tuple",
                  [
                    "string"
                  ]
                ]
              ]
            }
          },
          "element_type": [
            "list",
            [
              "tuple",
              [
                "string"
              ]
            ]
          ]
        }
      },
      "blocks": []
