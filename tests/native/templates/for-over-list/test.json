{
  "description": "A for directive over a list visits the elements in order with their indexes as keys",
  "spec": [
    "hclsyntax/spec.md#template-for-directive",
    "hclsyntax/spec.md#for-expressions"
  ],
  "op": "eval",
  "features": [
    "typed-values"
  ],
  "variables": {
    "l": {
      "list": [
        {
          "string": "x"
        },
        {
          "string": "y"
        }
      ],
      "element_type": "string"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "string": "0=x;1=y;"
        }
      },
      "blocks": []
    }
  }
}
