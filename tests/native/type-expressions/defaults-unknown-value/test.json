{
  "description": "An unknown value gets no defaults and converts to an unknown value of the type",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes",
    "spec.md#unknown-values-and-the-dynamic-pseudo-type"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "unknown-values",
    "functions",
    "type-expressions"
  ],
  "variables": {
    "u": {
      "unknown": "dynamic"
    }
  },
  "functions": {
    "convert": {
      "extension": "convert-with-defaults"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "unknown": [
            "object",
            {
              "a": "string"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
