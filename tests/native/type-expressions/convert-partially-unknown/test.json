{
  "description": "Converting a tuple with an unknown element to a list gives an unknown element of the element type",
  "spec": [
    "ext/typeexpr/README.md#the-convert-cty-function",
    "spec.md#unknown-values-and-the-dynamic-pseudo-type"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "unknown-values",
    "functions",
    "type-expressions"
  ],
  "variables": {
    "u": {
      "unknown": "number"
    }
  },
  "functions": {
    "convert": {
      "extension": "convert"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "list": [
            {
              "unknown": "string"
            },
            {
              "string": "1"
            }
          ],
          "element_type": "string"
        }
      },
      "blocks": []
    }
  }
}
