{
  "description": "A null value gets no defaults and converts to a null of the type",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes",
    "spec.md#conversion-of-null-values"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "functions",
    "type-expressions"
  ],
  "functions": {
    "convert": {
      "extension": "convert-with-defaults"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "null": [
            "object",
            {
              "a": "string"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
