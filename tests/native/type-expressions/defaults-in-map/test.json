{
  "description": "Defaults apply to each object in a map",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "functions",
    "type-expressions"
  ],
  "functions": {
    "convert": {
      "extension": "convert-with-defaults"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "map": {
            "k": {
              "object": {
                "a": {
                  "string": "x"
                }
              }
            }
          },
          "element_type": [
            "object",
            {
              "a": "string"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
