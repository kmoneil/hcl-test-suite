{
  "description": "An object type constraint with an optional attribute can be a tuple element type",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes"
  ],
  "op": "decode",
  "features": [
    "static-analysis",
    "type-expressions"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "type-constraint"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "type": [
            "tuple",
            [
              [
                "object",
                {
                  "a": "string"
                },
                [
                  "a"
                ]
              ]
            ]
          ]
        }
      },
      "blocks": []
    }
  }
}
