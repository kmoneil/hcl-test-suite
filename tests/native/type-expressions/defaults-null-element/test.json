{
  "description": "A null element of a map of objects stays null",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "functions",
    "type-expressions"
  ],
  "functions": {
    "convert": {
      "extension": "convert-with-defaults"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "map": {
            "k": {
              "null": [
                "object",
                {
                  "a": "string"
                }
              ]
            }
          },
          "element_type": [
            "object",
            {
              "a": "string"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
