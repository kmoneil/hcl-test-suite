{
  "description": "Defaults apply to an object nested in a list inside another object",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "functions",
    "type-expressions"
  ],
  "functions": {
    "convert": {
      "extension": "convert-with-defaults"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "object": {
            "a": {
              "list": [
                {
                  "object": {
                    "b": {
                      "object": {
                        "c": {
                          "bool": true
                        }
                      }
                    }
                  }
                }
              ],
              "element_type": [
                "object",
                {
                  "b": [
                    "object",
                    {
                      "c": "bool"
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "blocks": []
    }
  }
}
