{
  "description": "An object type constraint can have several optional attributes",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes"
  ],
  "op": "decode",
  "features": [
    "static-analysis",
    "type-expressions"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "type-constraint"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "type": [
            "object",
            {
              "a": "number",
              "b": "string",
              "c": "bool"
            },
            [
              "a",
              "b"
            ]
          ]
        }
      },
      "blocks": []
    }
  }
}
