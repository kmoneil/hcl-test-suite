{
  "description": "Defaults apply to each object element of a set value",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "functions",
    "type-expressions"
  ],
  "variables": {
    "v": {
      "set": [
        {
          "object": {
            "b": {
              "number": "1"
            }
          }
        },
        {
          "object": {
            "b": {
              "number": "2"
            }
          }
        }
      ],
      "element_type": [
        "object",
        {
          "b": "number"
        }
      ]
    }
  },
  "functions": {
    "convert": {
      "extension": "convert-with-defaults"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "set": [
            {
              "object": {
                "a": {
                  "string": "x"
                },
                "b": {
                  "number": "1"
                }
              }
            },
            {
              "object": {
                "a": {
                  "string": "x"
                },
                "b": {
                  "number": "2"
                }
              }
            }
          ],
          "element_type": [
            "object",
            {
              "a": "string",
              "b": "number"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
