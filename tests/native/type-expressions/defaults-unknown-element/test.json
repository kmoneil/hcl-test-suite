{
  "description": "An unknown element stays unknown while the other elements get defaults",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes",
    "spec.md#unknown-values-and-the-dynamic-pseudo-type"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "unknown-values",
    "functions",
    "type-expressions"
  ],
  "variables": {
    "u": {
      "unknown": "dynamic"
    }
  },
  "functions": {
    "convert": {
      "extension": "convert-with-defaults"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "list": [
            {
              "unknown": [
                "object",
                {
                  "a": "string"
                }
              ]
            },
            {
              "object": {
                "a": {
                  "string": "x"
                }
              }
            }
          ],
          "element_type": [
            "object",
            {
              "a": "string"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
