{
  "description": "Converting to a list of any unifies the element types",
  "spec": [
    "ext/typeexpr/README.md#the-convert-cty-function",
    "spec.md#type-unification"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "functions",
    "type-expressions"
  ],
  "functions": {
    "convert": {
      "extension": "convert"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "list": [
            {
              "string": "1"
            },
            {
              "string": "x"
            }
          ],
          "element_type": "string"
        }
      },
      "blocks": []
    }
  }
}
