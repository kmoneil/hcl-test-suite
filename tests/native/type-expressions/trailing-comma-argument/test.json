{
  "description": "A trailing comma after a type constructor's argument is allowed",
  "spec": [
    "ext/typeexpr/README.md#type-expression-syntax",
    "hclsyntax/spec.md#functions-and-function-calls"
  ],
  "op": "decode",
  "features": [
    "typed-values",
    "static-analysis",
    "type-expressions"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "type"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "type": [
            "set",
            "string"
          ]
        }
      },
      "blocks": []
    }
  }
}
