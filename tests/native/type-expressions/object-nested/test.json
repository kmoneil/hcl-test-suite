{
  "description": "An object attribute's type can be another object type",
  "spec": [
    "ext/typeexpr/README.md#type-expression-syntax"
  ],
  "op": "decode",
  "features": [
    "typed-values",
    "static-analysis",
    "type-expressions"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "type"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "type": [
            "object",
            {
              "a": [
                "object",
                {
                  "b": [
                    "list",
                    "number"
                  ]
                }
              ]
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
