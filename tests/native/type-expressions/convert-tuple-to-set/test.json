{
  "description": "Converting a tuple to a set keeps equal elements once",
  "spec": [
    "ext/typeexpr/README.md#the-convert-cty-function",
    "spec.md#collection-and-structural-type-conversions"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "functions",
    "type-expressions"
  ],
  "functions": {
    "convert": {
      "extension": "convert"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "set": [
            {
              "number": "1"
            },
            {
              "number": "2"
            }
          ],
          "element_type": "number"
        }
      },
      "blocks": []
    }
  }
}
