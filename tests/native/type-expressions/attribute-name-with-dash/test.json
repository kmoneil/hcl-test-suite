{
  "description": "An object attribute name can contain a dash",
  "spec": [
    "ext/typeexpr/README.md#type-expression-syntax",
    "hclsyntax/spec.md#identifiers"
  ],
  "op": "decode",
  "features": [
    "static-analysis",
    "type-expressions"
  ],
  "schema": {
    "mode": "exhaustive",
    "attributes": [
      {
        "name": "a",
        "analysis": {
          "kind": "type"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "type": [
            "object",
            {
              "a-b": "string"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
