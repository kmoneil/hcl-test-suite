{
  "description": "An empty set value stays empty when converted with defaults",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes"
  ],
  "op": "eval",
  "features": [
    "typed-values",
    "functions",
    "type-expressions"
  ],
  "variables": {
    "s": {
      "set": [],
      "element_type": [
        "object",
        {}
      ]
    }
  },
  "functions": {
    "convert": {
      "extension": "convert-with-defaults"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "set": [],
          "element_type": [
            "object",
            {
              "a": "string"
            }
          ]
        }
      },
      "blocks": []
    }
  }
}
