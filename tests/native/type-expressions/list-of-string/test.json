{
  "description": "The type list(string) is the list of string type",
  "spec": [
    "ext/typeexpr/README.md#type-expression-syntax"
  ],
  "op": "decode",
  "features": [
    "typed-values",
    "static-analysis",
    "type-expressions"
  ],
  "schema": {
    "mode": "exhaustive",
