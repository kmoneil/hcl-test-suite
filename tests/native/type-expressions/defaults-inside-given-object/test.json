{
  "description": "A given object for an optional attribute gets the defaults of its attributes",
  "spec": [
    "ext/typeexpr/README.md#optional-object-attributes"
  ],
  "op": "eval",
  "features": [
    "functions",
    "type-expressions"
  ],
  "functions": {
    "convert": {
      "extension": "convert-with-defaults"
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "a": {
          "object": {
            "a": {
              "object": {
                "b": {
                  "number": "1"
                }
              }
            }
          }
        }
      },
      "blocks": []
    }
  }
}
