{
  "description": "An empty content block gives each generated block an empty body",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": []
          }
        }
      ]
    }
  }
}
