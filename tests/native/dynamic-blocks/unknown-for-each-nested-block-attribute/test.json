{
  "description": "With an unknown for_each, the attributes of a block nested in the content are unknown",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "spec.md#unknown-values-and-the-dynamic-pseudo-type"
  ],
  "op": "decode",
  "features": [
    "unknown-values",
    "dynamic-blocks"
  ],
  "status": "disputed",
  "notes": "The README says an unknown for_each generates a single block whose iterator key and value are unknown, so that attributes derived from the iteration are unknown, which leaves the other attributes as they are. hashicorp/hcl replaces every attribute of the generated block, and of the blocks nested in it, with the dynamic value without evaluating it (unknownBody in ext/dynblock/unknown_body.go), so w is unknown instead of 1.",
  "variables": {
    "u": {
      "unknown": "dynamic"
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "blocks": [
            {
              "type": "c",
              "body": {
                "mode": "exhaustive",
                "attributes": [
                  {
                    "name": "w"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": [
              {
                "type": "c",
                "labels": [],
                "body": {
                  "attributes": {
                    "w": {
                      "unknown": "dynamic"
                    }
                  },
                  "blocks": []
                }
              }
            ]
          }
        }
      ]
    }
  }
}
