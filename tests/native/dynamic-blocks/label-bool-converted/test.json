{
  "description": "A bool label value becomes true or false",
  "spec": [
    "ext/dynblock/README.md#usage",
    "spec.md#primitive-type-conversions"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "notes": "Block labels are strings. The information model attempts automatic conversion when a value doesn't have the type that is needed, and gives the bool values true and false the strings true and false.",
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "labels": [
          "name"
        ],
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [
            "true"
          ],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
