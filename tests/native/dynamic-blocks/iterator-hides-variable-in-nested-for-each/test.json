{
  "description": "The iterator hides a variable of the same name in a nested for_each",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "ext/dynblock/README.md#usage",
    "hclsyntax/spec.md#variables-and-variable-expressions"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "variables": {
    "a": {
      "object": {
        "value": {
          "tuple": [
            {
              "string": "outer"
            }
          ]
        }
      }
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "a",
        "body": {
          "mode": "exhaustive",
          "blocks": [
            {
              "type": "b",
              "body": {
                "mode": "exhaustive",
                "attributes": [
                  {
                    "name": "v"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "a",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": [
              {
                "type": "b",
                "labels": [],
                "body": {
                  "attributes": {
                    "v": {
                      "string": "x"
                    }
                  },
                  "blocks": []
                }
              }
            ]
          }
        }
      ]
    }
  }
}
