{
  "description": "A dynamic block without labels for a block type with labels is an error",
  "spec": [
    "ext/dynblock/README.md#usage",
    "spec.md#schema-driven-processing"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "labels": [
          "name"
        ],
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "reference_error": "The argument \"labels\" is required",
  "expect": {
    "valid": false,
    "phase": "schema"
  }
}
