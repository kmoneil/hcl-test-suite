{
  "description": "In literal-only mode, dynamic blocks are still expanded",
  "spec": [
    "ext/dynblock/README.md#usage",
    "spec.md#expression-evaluation"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "evaluation_mode": "literal-only",
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
