{
  "description": "Dynamic blocks left by partial processing are expanded in the remaining body",
  "spec": [
    "ext/dynblock/README.md#usage",
    "spec.md#partial-processing-of-body-content"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "partial",
    "attributes": [
      {
        "name": "c"
      }
    ],
    "remain": {
      "mode": "exhaustive",
      "blocks": [
        {
          "type": "b",
          "body": {
            "mode": "exhaustive",
            "attributes": [
              {
                "name": "v"
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {
        "c": {
          "number": "1"
        }
      },
      "blocks": [],
      "remain": {
        "attributes": {},
        "blocks": [
          {
            "type": "b",
            "labels": [],
            "body": {
              "attributes": {
                "v": {
                  "string": "static"
                }
              },
              "blocks": []
            }
          },
          {
            "type": "b",
            "labels": [],
            "body": {
              "attributes": {
                "v": {
                  "string": "x"
                }
              },
              "blocks": []
            }
          }
        ]
      }
    }
  }
}
