{
  "description": "A set generates a block for each of its elements",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension"
  ],
  "op": "decode",
  "features": [
    "typed-values",
    "dynamic-blocks"
  ],
  "variables": {
    "xs": {
      "set": [
        {
          "string": "x"
        },
        {
          "string": "y"
        },
        {
          "string": "z"
        }
      ],
      "element_type": "string"
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
