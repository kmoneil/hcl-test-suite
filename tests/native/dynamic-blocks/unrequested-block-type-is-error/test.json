{
  "description": "A dynamic block for a block type the schema doesn't request is an error",
  "spec": [
    "ext/dynblock/README.md#usage",
    "spec.md#schema-driven-processing"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "reference_error": "Blocks of type \"c\" are not expected here",
  "expect": {
    "valid": false,
    "phase": "schema"
  }
}
