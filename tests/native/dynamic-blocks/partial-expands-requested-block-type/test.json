{
  "description": "Partial processing expands dynamic blocks of requested types and leaves none in the remaining body",
  "spec": [
    "ext/dynblock/README.md#usage",
    "spec.md#partial-processing-of-body-content"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "partial",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ],
    "remain": {
      "mode": "exhaustive",
      "attributes": [
        {
          "name": "c"
        }
      ]
    }
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "string": "static"
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "string": "x"
              }
            },
            "blocks": []
          }
        }
      ],
      "remain": {
        "attributes": {
          "c": {
            "number": "1"
          }
        },
        "blocks": []
      }
    }
  }
}
