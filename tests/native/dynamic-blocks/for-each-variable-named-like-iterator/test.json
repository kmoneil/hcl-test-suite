{
  "description": "A for_each uses the variable named like the iterator, while the content uses the iterator",
  "spec": [
    "ext/dynblock/README.md#usage",
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "variables": {
    "b": {
      "tuple": [
        {
          "string": "x"
        }
      ]
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "string": "x"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
