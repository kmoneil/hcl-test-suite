{
  "description": "A dynamic block in the remaining body of a generated block can use the enclosing iterator",
  "spec": [
    "ext/dynblock/README.md#usage",
    "spec.md#partial-processing-of-body-content"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "partial",
          "attributes": [
            {
              "name": "v"
            }
          ],
          "remain": {
            "mode": "exhaustive",
            "blocks": [
              {
                "type": "c",
                "labels": [
                  "name"
                ],
                "body": {
                  "mode": "exhaustive",
                  "attributes": [
                    {
                      "name": "w"
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": [],
            "remain": {
              "attributes": {},
              "blocks": [
                {
                  "type": "c",
                  "labels": [
                    "x"
                  ],
                  "body": {
                    "attributes": {
                      "w": {
                        "string": "xx"
                      }
                    },
                    "blocks": []
                  }
                }
              ]
            }
          }
        },
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": [],
            "remain": {
              "attributes": {},
              "blocks": [
                {
                  "type": "c",
                  "labels": [
                    "y"
                  ],
                  "body": {
                    "attributes": {
                      "w": {
                        "string": "yy"
                      }
                    },
                    "blocks": []
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
