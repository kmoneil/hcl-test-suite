{
  "description": "A dynamic block in content uses the variables and functions given to the expansion",
  "spec": [
    "ext/dynblock/README.md#usage"
  ],
  "op": "decode",
  "features": [
    "functions",
    "dynamic-blocks"
  ],
  "variables": {
    "xs": {
      "tuple": [
        {
          "string": "x"
        }
      ]
    }
  },
  "functions": {
    "f": {
      "result": {
        "value": {
          "string": "l"
        }
      }
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "a",
        "body": {
          "mode": "exhaustive",
          "blocks": [
            {
              "type": "b",
              "labels": [
                "name"
              ],
              "body": {
                "mode": "exhaustive",
                "attributes": [
                  {
                    "name": "v"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "a",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": [
              {
                "type": "b",
                "labels": [
                  "pl"
                ],
                "body": {
                  "attributes": {
                    "v": {
                      "string": "x"
                    }
                  },
                  "blocks": []
                }
              }
            ]
          }
        },
        {
          "type": "a",
          "labels": [],
          "body": {
            "attributes": {},
            "blocks": [
              {
                "type": "b",
                "labels": [
                  "ql"
                ],
                "body": {
                  "attributes": {
                    "v": {
                      "string": "x"
                    }
                  },
                  "blocks": []
                }
              }
            ]
          }
        }
      ]
    }
  }
}
