{
  "description": "A dynamic block with a block other than content is an error",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "spec.md#schema-driven-processing"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ],
          "blocks": [
            {
              "type": "other",
              "body": {
                "mode": "exhaustive"
              }
            }
          ]
        }
      }
    ]
  },
  "reference_error": "Blocks of type \"other\" are not expected here",
  "expect": {
    "valid": false,
    "phase": "schema"
  }
}
