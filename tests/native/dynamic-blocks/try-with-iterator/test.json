{
  "description": "The try function in content evaluates its arguments with the iterator in scope",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "ext/tryfunc/README.md#try-and-can-functions"
  ],
  "op": "decode",
  "features": [
    "functions",
    "try-functions",
    "dynamic-blocks"
  ],
  "functions": {
    "try": {
      "extension": "try"
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "string": "1"
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "string": "none"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
