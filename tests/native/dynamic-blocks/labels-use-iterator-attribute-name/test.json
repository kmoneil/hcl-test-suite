{
  "description": "Labels use the name that the iterator attribute gives",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "ext/dynblock/README.md#usage"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "labels": [
          "name"
        ],
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [
            "x"
          ],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        },
        {
          "type": "b",
          "labels": [
            "y"
          ],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
