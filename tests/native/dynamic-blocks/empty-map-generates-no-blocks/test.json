{
  "description": "A dynamic block with an empty map generates no blocks",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension"
  ],
  "op": "decode",
  "features": [
    "typed-values",
    "dynamic-blocks"
  ],
  "variables": {
    "m": {
      "map": {},
      "element_type": "string"
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": []
    }
  }
}
