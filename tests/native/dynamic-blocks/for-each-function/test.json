{
  "description": "The for_each of a dynamic block can call functions",
  "spec": [
    "ext/dynblock/README.md#usage"
  ],
  "op": "decode",
  "features": [
    "functions",
    "dynamic-blocks"
  ],
  "functions": {
    "f": {
      "result": {
        "value": {
          "tuple": [
            {
              "string": "x"
            }
          ]
        }
      }
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "string": "x"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
