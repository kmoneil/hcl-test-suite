{
  "description": "The iterator hides a variable of the same name in labels",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "ext/dynblock/README.md#usage",
    "hclsyntax/spec.md#variables-and-variable-expressions"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "variables": {
    "b": {
      "object": {
        "value": {
          "string": "outer"
        }
      }
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "labels": [
          "name"
        ],
        "body": {
          "mode": "exhaustive",
          "attributes": [
            {
              "name": "v"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [
            "x"
          ],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
