{
  "description": "Dynamic attributes processing of a generated block gives its attributes",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "spec.md#dynamic-attributes-processing"
  ],
  "op": "decode",
  "features": [
    "dynamic-blocks"
  ],
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "dynamic-attributes"
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "number": "1"
              }
            },
            "blocks": []
          }
        }
      ]
    }
  }
}
