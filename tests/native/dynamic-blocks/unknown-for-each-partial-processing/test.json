{
  "description": "With an unknown for_each, partial processing of the generated block gives unknown attributes",
  "spec": [
    "ext/dynblock/README.md#hcl-dynamic-blocks-extension",
    "spec.md#unknown-values-and-the-dynamic-pseudo-type",
    "spec.md#partial-processing-of-body-content"
  ],
  "op": "decode",
  "features": [
    "unknown-values",
    "dynamic-blocks"
  ],
  "status": "disputed",
  "notes": "The README says an unknown for_each generates a single block whose iterator key and value are unknown, so that attributes derived from the iteration are unknown, which leaves the other attributes as they are. hashicorp/hcl replaces every attribute of the generated block, and of the blocks nested in it, with the dynamic value without evaluating it (unknownBody in ext/dynblock/unknown_body.go), in the remaining body too.",
  "variables": {
    "u": {
      "unknown": "dynamic"
    }
  },
  "dynamic_blocks": true,
  "schema": {
    "mode": "exhaustive",
    "blocks": [
      {
        "type": "b",
        "body": {
          "mode": "partial",
          "attributes": [
            {
              "name": "v"
            }
          ],
          "remain": {
            "mode": "exhaustive",
            "attributes": [
              {
                "name": "w"
              }
            ]
          }
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "body": {
      "attributes": {},
      "blocks": [
        {
          "type": "b",
          "labels": [],
          "body": {
            "attributes": {
              "v": {
                "unknown": "dynamic"
              }
            },
            "blocks": [],
            "remain": {
              "attributes": {
                "w": {
                  "unknown": "dynamic"
                }
              },
              "blocks": []
            }
          }
        }
      ]
    }
  }
}
