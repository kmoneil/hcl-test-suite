{
  "area": "native/templates",
  "rules": [
    {
      "id": "templates-literal-text-verbatim",
      "spec": "hclsyntax/spec.md#template-literals",
      "rule": "Text outside interpolation and directive sequences, including its spaces, is copied into the result unchanged",
      "tests": [
        "native/templates/literal-text-around-interpolation-is-kept",
        "native/templates/template-parts-parse-tree",
        "native/templates/non-ascii-template-literal-text-is-kept"
      ]
    },
    {
      "id": "templates-literal-comment-markers-are-text",
      "spec": "hclsyntax/spec.md#comments-and-whitespace",
      "rule": "Comment introducers (#, // and /*) inside a template literal are literal text, in quoted templates and heredocs",
      "tests": [
        "native/templates/comment-markers-in-quoted-template-are-text",
        "native/templates/comment-markers-in-heredoc-template-are-text"
      ]
    },
    {
      "id": "templates-escape-interpolation",
      "spec": "hclsyntax/spec.md#template-literals",
      "rule": "$${ is an escape that produces the text ${ and does not start an interpolation",
      "tests": [
        "native/templates/escaped-sequence-starts",
        "native/templates/escaped-interpolation-parse-tree",
        "native/templates/escaped-interpolation-at-end-of-template",
        "native/templates/escaped-interpolation-in-heredoc",
        "native/templates/interpolation-right-after-escaped-interpolation",
        "native/templates/escaped-interpolation-in-nested-template"
      ]
    },
    {
      "id": "templates-escape-directive",
      "spec": "hclsyntax/spec.md#template-literals",
      "rule": "%%{ is an escape that produces the text %{ and does not start a directive",
      "tests": [
        "native/templates/escaped-sequence-starts",
        "native/templates/escaped-directive-parse-tree",
        "native/templates/escaped-directive-at-end-of-template",
        "native/templates/escaped-directive-in-heredoc",
        "native/templates/directive-right-after-escaped-directive"
      ]
    },
    {
      "id": "templates-escape-with-tilde",
      "spec": "hclsyntax/spec.md#template-literals",
      "rule": "An escaped sequence followed by ~ is literal text; the ~ is not a strip marker",
      "tests": [
        "native/templates/escaped-interpolation-with-tilde-is-literal",
        "native/templates/escaped-directive-with-tilde-is-literal"
      ]
    },
    {
      "id": "templates-escape-runs",
      "spec": "hclsyntax/spec.md#template-literals",
      "rule": "In a run of three or more $ (or %) before {, the last two characters form the escape and the earlier ones are literal text, so no sequence starts",
      "tests": [
        "native/templates/three-dollars-before-brace",
        "native/templates/four-dollars-before-brace",
        "native/templates/three-percents-before-brace"
      ]
    },
    {
      "id": "templates-lone-introducer-characters",
      "spec": "hclsyntax/spec.md#template-literals",
      "rule": "A $ or % that is not immediately followed by { (in the source text) is literal text, including at the end of a template or line",
      "tests": [
        "native/templates/dollar-at-end-of-template-is-literal",
        "native/templates/percent-at-end-of-template-is-literal",
        "native/templates/dollar-before-other-character-is-literal",
        "native/templates/percent-before-other-character-is-literal",
        "native/templates/doubled-dollar-and-percent-without-brace-are-literal",
        "native/templates/dollar-right-before-directive-is-literal",
        "native/templates/percent-right-before-interpolation-is-literal",
        "native/templates/introducer-split-across-heredoc-lines-is-literal",
        "native/templates/dollar-before-escaped-brace-is-literal"
      ]
    },
    {
      "id": "templates-braces-and-tildes-are-text",
      "spec": "hclsyntax/spec.md#template-literals",
      "rule": "{, } and ~} outside a sequence are literal text",
      "tests": [
        "native/templates/braces-in-template-literal-are-text",
        "native/templates/tilde-brace-in-template-literal-is-text"
      ]
    },
    {
      "id": "templates-standalone-literals",
      "spec": "hclsyntax/spec.md#template-literals",
      "rule": "In a standalone template, literals can contain any character (including quotes and newlines) without escapes, except the sequence introducers",
      "tests": [
        "json/expressions/string-standalone-template-literal-characters",
        "json/expressions/string-heredoc-syntax-is-text"
      ]
    },
    {
      "id": "templates-interpolation-evaluates-expression",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "An interpolation sequence holds one expression of any kind; it is evaluated and its string form replaces the sequence",
      "tests": [
        "native/templates/interpolation-evaluates-expression",
        "native/templates/interpolation-with-conditional-parse-tree"
      ]
    },
    {
      "id": "templates-interpolation-spaces",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "Spaces and tabs between ${, the expression and } are ignored",
      "tests": [
        "native/templates/interpolation-allows-spaces-and-tabs"
      ]
    },
    {
      "id": "templates-interpolation-comments",
      "spec": "hclsyntax/spec.md#comments-and-whitespace",
      "rule": "Inline comments can appear inside an interpolation sequence and act as spaces; braces and quotes inside them don't end the interpolation or the template",
      "tests": [
        "native/templates/interpolation-allows-inline-comments",
        "native/templates/comment-with-brace-inside-interpolation",
        "native/templates/quote-in-comment-inside-interpolation"
      ]
    },
    {
      "id": "templates-interpolation-newlines",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "Newlines and line comments inside an interpolation sequence are ignored, in quoted templates and heredocs (disputed)",
      "tests": [
        "native/templates/interpolation-allows-newlines-in-quoted-template",
        "native/templates/interpolation-allows-newlines-in-heredoc",
        "native/templates/interpolation-allows-hash-line-comment",
        "native/templates/interpolation-allows-slash-line-comment-in-heredoc"
      ]
    },
    {
      "id": "templates-quoted-template-multiline-interpolation",
      "spec": "hclsyntax/spec.md#template-expressions",
      "rule": "An interpolation in a quoted template can span lines through constructs that allow line breaks: a heredoc, an inline comment or parentheses (disputed)",
      "tests": [
        "native/templates/heredoc-in-quoted-template-interpolation",
        "native/templates/multiline-comment-in-quoted-template-interpolation",
        "native/templates/parenthesized-newlines-in-quoted-template-interpolation"
      ]
    },
    {
      "id": "templates-interpolation-requires-expression",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "An interpolation sequence without an expression (empty, blank, only a comment or only strip markers) is a syntax error",
      "tests": [
        "native/templates/empty-interpolation-is-error",
        "native/templates/blank-interpolation-is-error",
        "native/templates/comment-only-interpolation-is-error",
        "native/templates/strip-markers-alone-are-not-an-interpolation"
      ]
    },
    {
      "id": "templates-interpolation-single-expression",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "Only one expression is allowed in an interpolation; anything after it other than } is a syntax error",
      "tests": [
        "native/templates/interpolation-with-two-expressions-is-error",
        "native/templates/interpolation-with-colon-is-error"
      ]
    },
    {
      "id": "templates-interpolation-must-be-closed",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "An interpolation sequence without its closing } is a syntax error",
      "tests": [
        "native/templates/unclosed-interpolation-in-quoted-template-is-error",
        "native/templates/unclosed-interpolation-in-heredoc-is-error"
      ]
    },
    {
      "id": "templates-interpolation-nesting",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "The expression in an interpolation can contain templates with their own quotes, braces, escapes, interpolations and directives, which don't end the outer sequence",
      "tests": [
        "native/templates/nested-templates-in-interpolations",
        "native/templates/nested-template-parse-tree",
        "native/templates/closing-brace-in-nested-string-does-not-end-interpolation",
        "native/templates/closing-brace-in-nested-heredoc-does-not-end-interpolation",
        "native/templates/escaped-quote-in-nested-string",
        "native/templates/object-braces-inside-interpolation",
        "native/templates/directive-in-nested-template",
        "native/templates/quoted-template-in-heredoc-interpolation",
        "native/templates/directives-cannot-span-nested-templates",
        "native/templates/directive-is-not-an-expression",
        "native/templates/heredoc-in-quoted-template-interpolation"
      ]
    },
    {
      "id": "templates-convert-string",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "An interpolated string is inserted as is: its whitespace is kept and template syntax inside it is not evaluated",
      "tests": [
        "native/templates/interpolated-string-is-inserted-unchanged",
        "native/templates/interpolated-template-syntax-is-not-evaluated"
      ]
    },
    {
      "id": "templates-convert-number",
      "spec": "spec.md#primitive-type-conversions",
      "rule": "An interpolated number becomes its decimal digits, with a - sign if negative, a period and fractional digits only if the fraction is non-zero, no exponent, and full precision",
      "tests": [
        "native/templates/interpolated-integer",
        "native/templates/interpolated-negative-integer",
        "native/templates/interpolated-fraction",
        "native/templates/interpolated-negative-fraction",
        "native/templates/interpolated-number-from-positive-exponent",
        "native/templates/interpolated-number-from-negative-exponent",
        "native/templates/interpolated-number-drops-trailing-zeros",
        "native/templates/interpolated-whole-number-has-no-period",
        "native/templates/interpolated-large-integer-keeps-all-digits",
        "native/templates/interpolated-small-fraction-has-no-exponent",
        "native/templates/interpolated-fraction-keeps-full-precision"
      ]
    },
    {
      "id": "templates-convert-negative-zero",
      "spec": "spec.md#primitive-type-conversions",
      "rule": "Interpolating a negated zero produces -0 (disputed)",
      "tests": [
        "native/templates/interpolated-negative-zero"
      ]
    },
    {
      "id": "templates-convert-infinity",
      "spec": "spec.md#primitive-type-conversions",
      "rule": "Interpolating positive infinity produces +Inf and negative infinity produces -Inf (disputed)",
      "tests": [
        "native/templates/interpolated-infinity",
        "native/templates/interpolated-negative-infinity"
      ]
    },
    {
      "id": "templates-convert-bool",
      "spec": "spec.md#primitive-type-conversions",
      "rule": "An interpolated bool becomes true or false",
      "tests": [
        "native/templates/interpolated-bools"
      ]
    },
    {
      "id": "templates-convert-null",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "Interpolating a null value, typed or not, in a template that isn't unwrapped is an error (disputed)",
      "tests": [
        "native/templates/interpolated-null-is-error",
        "native/templates/interpolated-typed-null-is-error",
        "native/templates/for-body-null-is-error"
      ]
    },
    {
      "id": "templates-convert-collections",
      "spec": "hclsyntax/spec.md#template-interpolations",
      "rule": "Tuples, objects, lists, maps and sets have no conversion to string, so interpolating them in a template that isn't unwrapped is an error",
      "tests": [
        "native/templates/interpolated-tuple-is-error",
        "native/templates/interpolated-empty-tuple-is-error",
        "native/templates/interpolated-object-is-error",
        "native/templates/interpolated-list-is-error",
        "native/templates/interpolated-map-is-error",
        "native/templates/interpolated-set-is-error"
      ]
    },
    {
      "id": "templates-unwrap-single-interpolation",
      "spec": "hclsyntax/spec.md#template-interpolation-unwrapping",
      "rule": "A template that is exactly one interpolation returns the expression's value unchanged, of any type, including null",
      "tests": [
        "native/templates/single-interpolation-unwraps",
        "native/templates/unwrapped-template-parse-tree",
        "native/templates/unwrapped-number-stays-number",
        "native/templates/unwrapped-null-is-not-error",
        "native/templates/unwrapped-typed-null-keeps-type",
        "native/templates/unwrapped-tuple",
        "native/templates/unwrapped-object",
        "native/templates/unwrapped-list-keeps-type",
        "native/templates/unwrapped-map-keeps-type",
        "native/templates/unwrapped-set-keeps-type",
        "native/templates/nested-templates-unwrap",
        "native/templates/unwrapping-through-parentheses",
        "native/templates/strip-markers-do-not-prevent-unwrapping",
        "native/templates/comments-do-not-prevent-unwrapping"
      ]
    },
    {
      "id": "templates-unwrap-not-with-literals",
      "spec": "hclsyntax/spec.md#template-interpolation-unwrapping",
      "rule": "A template with any literal next to its interpolation produces a string, even if strip markers leave the literal empty",
      "tests": [
        "native/templates/literal-and-interpolation-produce-string",
        "native/templates/leading-space-prevents-unwrapping",
        "native/templates/trailing-space-prevents-unwrapping",
        "native/templates/stripped-literals-still-prevent-unwrapping",
        "native/templates/stripped-literals-parse-tree",
        "native/templates/heredoc-final-newline-prevents-unwrapping",
        "native/templates/heredoc-stripped-newline-still-prevents-unwrapping",
        "native/templates/heredoc-stripped-newline-parse-tree"
      ]
    },
    {
      "id": "templates-unwrap-not-with-several-interpolations",
      "spec": "hclsyntax/spec.md#template-interpolation-unwrapping",
      "rule": "A template with two or more interpolations produces a string, even if some of them produce empty strings",
      "tests": [
        "native/templates/two-interpolations-do-not-unwrap",
        "native/templates/adjacent-number-interpolations-concatenate"
      ]
    },
    {
      "id": "templates-unwrap-not-with-directives",
      "spec": "hclsyntax/spec.md#template-interpolation-unwrapping",
      "rule": "A template containing a directive produces a string, even if the directive yields a single interpolation's result",
      "tests": [
        "native/templates/for-directive-prevents-unwrapping",
        "native/templates/if-directive-prevents-unwrapping",
        "native/templates/template-of-only-directive-produces-empty-string"
      ]
    },
    {
      "id": "templates-result-concatenates-elements",
      "spec": "hclsyntax/spec.md#templates",
      "rule": "A template that isn't unwrapped evaluates its literals, interpolations and directives and joins their strings in source order into one string",
      "tests": [
        "native/templates/template-elements-concatenate-in-order",
        "native/templates/template-of-only-directive-produces-empty-string"
      ]
    },
    {
      "id": "templates-unwrap-application-conversion",
      "spec": "hclsyntax/spec.md#template-interpolation-unwrapping",
      "rule": "An application can circumvent unwrapping by converting the template's result to string",
      "untested": "The protocol evaluates attributes without a target type, so there is no way to request the conversion"
    },
    {
      "id": "templates-if-parse-tree",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "An if directive becomes a template_if part with its condition, then parts and else parts; an omitted or empty branch has no parts",
      "tests": [
        "native/templates/if-directive-syntax",
        "native/templates/if-directive-without-else-parse-tree",
        "native/templates/if-directive-with-empty-branches-parse-tree",
        "native/templates/nested-directives-parse-tree"
      ]
    },
    {
      "id": "templates-if-selects-branch",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "A true condition selects the first sub-template and a false one the else sub-template; a missing else produces an empty string",
      "tests": [
        "native/templates/if-true-selects-first-branch",
        "native/templates/if-false-selects-else-branch",
        "native/templates/if-false-without-else-produces-nothing",
        "native/templates/if-true-without-else-produces-branch",
        "native/templates/if-with-empty-selected-branch"
      ]
    },
    {
      "id": "templates-if-nesting",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "If directives nest inside either branch of an if directive and inside for directive bodies, and can contain for directives",
      "tests": [
        "native/templates/if-nested-in-first-branch",
        "native/templates/if-nested-in-else-branch",
        "native/templates/if-inside-for-body",
        "native/templates/for-inside-if-branch"
      ]
    },
    {
      "id": "templates-if-branches-are-strings",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "Each branch of an if directive is a template that produces a string: values interpolated in it are converted to strings, so the branches' values need no common type, and a value without a string conversion is an error",
      "tests": [
        "native/templates/if-branch-values-are-converted-to-strings",
        "native/templates/tuple-interpolation-in-if-branch-is-error"
      ]
    },
    {
      "id": "templates-if-unselected-branch-errors",
      "spec": "hclsyntax/spec.md#conditional-operator",
      "rule": "Errors in the branch that isn't selected are not reported; errors in the selected branch are",
      "tests": [
        "native/templates/if-ignores-errors-in-unselected-first-branch",
        "native/templates/if-ignores-errors-in-unselected-else-branch",
        "native/templates/if-reports-errors-in-selected-branch"
      ]
    },
    {
      "id": "templates-if-predicate-bool",
      "spec": "hclsyntax/spec.md#conditional-operator",
      "rule": "The condition can be any expression producing a bool, such as a variable or a comparison",
      "tests": [
        "native/templates/if-condition-from-variable",
        "native/templates/if-condition-from-comparison"
      ]
    },
    {
      "id": "templates-if-predicate-string-conversion",
      "spec": "spec.md#primitive-type-conversions",
      "rule": "A string condition is converted to bool: \"true\" and \"1\" are true, \"false\" and \"0\" are false, any other string is an error",
      "tests": [
        "native/templates/if-condition-string-true",
        "native/templates/if-condition-string-false",
        "native/templates/if-condition-strings-one-and-zero",
        "native/templates/if-condition-other-string-is-error",
        "native/templates/if-condition-uppercase-true-is-error"
      ]
    },
    {
      "id": "templates-if-predicate-invalid",
      "spec": "hclsyntax/spec.md#conditional-operator",
      "rule": "A condition that is a number, tuple, object or other value without a conversion to bool is an error",
      "tests": [
        "native/templates/if-condition-number-is-error",
        "native/templates/if-condition-tuple-is-error",
        "native/templates/if-condition-object-is-error"
      ]
    },
    {
      "id": "templates-if-predicate-null",
      "spec": "hclsyntax/spec.md#conditional-operator",
      "rule": "A null condition, from the null keyword or a typed null, is an error (disputed)",
      "tests": [
        "native/templates/if-condition-null-is-error",
        "native/templates/if-condition-null-bool-is-error"
      ]
    },
    {
      "id": "templates-if-syntax",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "An if directive needs a condition and a matching endif, allows at most one else, and its else and endif markers take nothing but the keyword",
      "tests": [
        "native/templates/if-without-endif-is-error",
        "native/templates/if-else-without-endif-is-error",
        "native/templates/else-without-if-is-error",
        "native/templates/endif-without-if-is-error",
        "native/templates/second-else-is-error",
        "native/templates/endfor-cannot-close-if",
        "native/templates/if-without-condition-is-error",
        "native/templates/if-with-two-conditions-is-error",
        "native/templates/else-if-is-error",
        "native/templates/endif-with-extra-tokens-is-error",
        "native/templates/unclosed-endif-marker-is-error",
        "native/templates/interleaved-directives-are-error"
      ]
    },
    {
      "id": "templates-directive-keywords",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "A directive starts with one of the lowercase keywords if, else, endif, for or endfor; anything else is a syntax error, while the same words are ordinary names inside interpolations",
      "tests": [
        "native/templates/directive-keywords-are-case-sensitive",
        "native/templates/unknown-directive-keyword-is-error",
        "native/templates/directive-without-keyword-is-error",
        "native/templates/empty-directive-is-error",
        "native/templates/directive-keywords-are-names-in-interpolations"
      ]
    },
    {
      "id": "templates-directive-whitespace",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "Inside a directive, spaces, tabs and inline comments between tokens are optional and ignored",
      "tests": [
        "native/templates/directives-need-no-spaces",
        "native/templates/directives-allow-tabs",
        "native/templates/directives-allow-inline-comments"
      ]
    },
    {
      "id": "templates-directive-newlines",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "Newlines and line comments inside a directive are ignored, in quoted templates and heredocs (disputed)",
      "tests": [
        "native/templates/directives-allow-newlines",
        "native/templates/directives-allow-newlines-in-heredoc",
        "native/templates/directives-allow-line-comments"
      ]
    },
    {
      "id": "templates-directive-expression-braces",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "Braces inside strings, objects or other nested constructs in a directive's expression do not close the directive",
      "tests": [
        "native/templates/if-condition-can-contain-brace-in-string",
        "native/templates/for-collection-can-contain-object-braces"
      ]
    },
    {
      "id": "templates-directive-expression-errors",
      "spec": "hclsyntax/spec.md#template-if-directive",
      "rule": "An error in an if condition or a for collection is reported even when the directive's branches or body are empty",
      "tests": [
        "native/templates/if-condition-error-with-empty-branches",
        "native/templates/for-collection-error-with-empty-body"
      ]
    },
    {
      "id": "templates-for-parse-tree",
      "spec": "hclsyntax/spec.md#template-for-directive",
      "rule": "A for directive becomes a template_for part with an optional key variable, a value variable, the collection and the body parts",
      "tests": [
        "native/templates/for-directive-one-variable-parse-tree",
        "native/templates/for-directive-two-variables-parse-tree",
        "native/templates/for-directive-empty-body-parse-tree"
      ]
    },
    {
      "id": "templates-for-tuple",
      "spec": "hclsyntax/spec.md#for-expressions",
      "rule": "Iterating a tuple visits elements in order, with the zero-based index as the key",
      "tests": [
        "native/templates/for-over-tuple-in-order",
        "native/templates/for-over-tuple-key-is-index",
        "native/templates/for-over-tuple-index-is-number"
      ]
    },
    {
      "id": "templates-for-list",
      "spec": "hclsyntax/spec.md#for-expressions",
      "rule": "Iterating a list visits elements in order, with the zero-based index as the key",
      "tests": [
        "native/templates/for-over-list"
      ]
    },
    {
      "id": "templates-for-object",
      "spec": "hclsyntax/spec.md#for-expressions",
      "rule": "Iterating an object visits attributes in lexicographic order of their names, with the name as the key",
      "tests": [
        "native/templates/for-over-object-sorts-keys",
        "native/templates/for-over-object-with-one-variable"
      ]
    },
    {
      "id": "templates-for-map",
      "spec": "hclsyntax/spec.md#for-expressions",
      "rule": "Iterating a map visits elements in lexicographic order of their keys, with the key as the key variable",
      "tests": [
        "native/templates/for-over-map-sorts-keys"
      ]
    },
    {
      "id": "templates-for-set",
