{
  "area": "native/functions",
  "rules": [
    {
      "id": "functions-call-parse",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "An identifier followed by parentheses parses as a function call with that name and its arguments in source order; there may be no arguments, and each argument is a full expression, such as a conditional or another call",
      "tests": [
        "native/functions/call-arguments-in-order",
        "native/functions/call-conditional-argument",
        "native/functions/call-nested-calls",
        "native/functions/call-no-arguments"
      ]
    },
    {
      "id": "functions-call-trailing-comma",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "The last argument may be followed by one comma, but every comma must follow an argument",
      "tests": [
        "native/functions/call-double-comma-is-error",
        "native/functions/call-only-comma-is-error",
        "native/functions/call-single-argument-trailing-comma",
        "native/functions/call-trailing-comma"
      ]
    },
    {
      "id": "functions-call-arguments-are-expressions",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "Arguments are positional expressions only: there are no named arguments, so name = value inside the parentheses is an error",
      "tests": [
        "native/functions/call-named-argument-is-error"
      ]
    },
    {
      "id": "functions-call-separator",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "Arguments must be separated by commas; a newline between two arguments is not a separator",
      "tests": [
        "native/functions/call-missing-separator-is-error",
        "native/functions/call-newline-is-not-separator"
      ]
    },
    {
      "id": "functions-call-unterminated",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A function call must be closed by a closing parenthesis",
      "tests": [
        "native/functions/call-unterminated-is-error"
      ]
    },
    {
      "id": "functions-expand-final-syntax",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "An ellipsis after the last argument, optionally separated by whitespace, marks the whole final argument expression of the innermost enclosing call for expansion, while the grouping ellipsis of a for expression argument doesn't",
      "tests": [
        "native/functions/call-expand-final",
        "native/functions/call-expand-final-after-other-arguments",
        "native/functions/call-expand-final-after-space",
        "native/functions/call-expand-final-number-argument",
        "native/functions/call-expand-final-operation-argument",
        "native/functions/call-argument-grouping-ellipsis-is-not-expansion",
        "native/functions/call-expand-final-belongs-to-inner-call"
      ]
    },
    {
      "id": "functions-expand-final-position",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "The ellipsis may only directly follow the last argument inside the parentheses: not an earlier argument, not a lone ellipsis, not before or after a trailing comma and not after the closing parenthesis",
      "tests": [
        "native/functions/call-expand-after-comma-is-error",
        "native/functions/call-expand-not-last-is-error",
        "native/functions/call-expand-outside-parentheses-is-error",
        "native/functions/call-expand-then-comma-is-error",
        "native/functions/call-expand-without-argument-is-error"
      ]
    },
    {
      "id": "functions-call-newlines",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "Newlines and comments anywhere between the parentheses of a function call are ignored",
      "tests": [
        "native/functions/call-comments-inside-parentheses",
        "native/functions/call-newline-before-comma",
        "native/functions/call-newlines-around-ellipsis",
        "native/functions/call-newlines-between-arguments"
      ]
    },
    {
      "id": "functions-call-space-before-parenthesis",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "Spaces and inline comments between the function name and the opening parenthesis are allowed",
      "tests": [
        "native/functions/call-comment-before-parenthesis",
        "native/functions/call-space-before-parenthesis"
      ]
    },
    {
      "id": "functions-call-newline-before-parenthesis",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A newline between the function name and the opening parenthesis is ignored only inside parentheses, tuple brackets, index brackets or function call parentheses; at the top level of an attribute it ends the expression",
      "tests": [
        "native/functions/call-newline-before-parenthesis-in-parentheses",
        "native/functions/call-newline-before-parenthesis-is-error",
        "native/functions/call-newline-before-parenthesis-in-tuple-brackets",
        "native/functions/call-newline-before-parenthesis-in-index-brackets",
        "native/functions/call-newline-before-parenthesis-in-call-arguments"
      ]
    },
    {
      "id": "functions-call-is-term",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A function call is an expression term, so attribute accesses, index operations and splats can follow it",
      "tests": [
        "native/functions/call-result-attribute-access",
        "native/functions/call-result-index",
        "native/functions/call-result-splat"
      ]
    },
    {
      "id": "functions-call-name-is-identifier",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "Only a plain identifier can be called: attribute accesses, parenthesized expressions, call results and strings can't be followed by an argument list",
      "tests": [
        "native/functions/call-on-attribute-is-error",
        "native/functions/call-on-parenthesized-name-is-error",
        "native/functions/call-quoted-name-is-error",
        "native/functions/call-result-cannot-be-called"
      ]
    },
    {
      "id": "functions-call-name-contextual-keywords",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "Identifiers that are keywords only in for expressions, such as for and if, can be called as function names",
      "tests": [
        "native/functions/call-name-for",
        "native/functions/call-name-if"
      ]
    },
    {
      "id": "functions-call-name-literal-keywords",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "The identifiers true, false and null followed by parentheses are calls to functions with those names (disputed)",
      "tests": [
        "native/functions/call-name-null",
        "native/functions/call-name-true"
      ]
    },
    {
      "id": "functions-call-name-characters",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A function name is an identifier, so it can contain dashes and non-ASCII letters, and a function with a non-ASCII name is called by that name",
      "tests": [
        "native/functions/call-name-non-ascii",
        "native/functions/call-name-with-dash",
        "native/functions/call-non-ascii-name-evaluates"
      ]
    },
    {
      "id": "functions-namespaced-call",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A function name can be several identifiers separated by ::, reported as one name joined with ::, with spaces allowed around :: and newlines only inside parentheses, tuple brackets, index brackets or function call parentheses (disputed)",
      "tests": [
        "native/functions/namespaced-call",
        "native/functions/namespaced-call-multiple-levels",
        "native/functions/namespaced-call-newlines-in-parentheses",
        "native/functions/namespaced-call-spaces",
        "native/functions/namespaced-call-newlines-in-tuple-brackets",
        "native/functions/namespaced-call-newlines-in-index-brackets",
        "native/functions/namespaced-call-newlines-in-call-arguments"
      ]
    },
    {
      "id": "functions-namespaced-call-malformed",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "Each :: in a function name must be preceded by an identifier and followed by an identifier, and a namespaced name must be followed by an argument list",
      "tests": [
        "native/functions/namespaced-call-leading-separator-is-error",
        "native/functions/namespaced-call-missing-name-is-error",
        "native/functions/namespaced-call-newline-after-separator-is-error",
        "native/functions/namespaced-call-triple-colon-is-error",
        "native/functions/namespaced-name-without-call-is-error"
      ]
    },
    {
      "id": "functions-unknown-function",
      "spec": "spec.md#functions-and-function-calls",
      "rule": "Calling a name that is not in the application's function table is an error when the call is evaluated, not during parsing, even when other functions are defined or an argument is unknown, so a call that is never evaluated causes no error",
      "tests": [
        "native/functions/namespaced-unknown-function-is-eval-error",
        "native/functions/unknown-function-in-unselected-branch",
        "native/functions/unknown-function-is-eval-error",
        "native/functions/unknown-function-with-other-functions-defined",
        "native/unknowns/function-undefined-function-with-dynamic-argument-is-error"
      ]
    },
    {
      "id": "functions-name-exact-match",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A call finds only the function with exactly its name: names that differ in case or in Unicode normalization, or by a namespace prefix, are different functions",
      "tests": [
        "native/functions/function-names-are-case-sensitive",
        "native/functions/function-names-are-not-normalized",
        "native/functions/namespaced-function-is-not-plain-function"
      ]
    },
    {
      "id": "functions-namespaced-function-call",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A namespaced call calls the function declared with the whole name joined with ::, never a function declared with only its last part, and is an error for a name the namespace lacks even when it has other functions (disputed)",
      "tests": [
        "native/functions/namespaced-call-does-not-find-plain-function",
        "native/functions/namespaced-function-call-evaluates",
        "native/functions/namespaced-function-call-multiple-levels",
        "native/functions/namespaced-unknown-function-in-known-namespace"
      ]
    },
    {
      "id": "functions-namespace-distinct-from-variables",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "Functions and variables are separate namespaces, so a variable does not make a function of the same name callable, and a local variable doesn't hide a function of the same name",
      "tests": [
        "native/functions/variable-is-not-a-function",
        "native/functions/call-in-for-expression-with-variable-named-like-function"
      ]
    },
    {
      "id": "functions-function-does-not-define-variable",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A function does not define a variable of the same name, and a function and a variable can share a name and both be used",
      "tests": [
        "native/functions/function-and-variable-with-same-name",
        "native/functions/function-name-is-not-a-variable"
      ]
    },
    {
      "id": "functions-call-returns-result",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A function call evaluates to the value the named function returns for the call's argument values, keeping its type; the arguments are evaluated where the call is, such as for each element of a for expression, and can be other calls",
      "tests": [
        "native/functions/call-as-argument-of-call",
        "native/functions/call-in-for-expression-uses-each-element",
        "native/functions/call-passes-argument-values",
        "native/functions/call-result-keeps-its-type",
        "native/functions/call-returns-function-result",
        "native/functions/call-without-arguments"
      ]
    },
    {
      "id": "functions-argument-errors",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "An error in an argument expression, including the expanded final one, makes the call an error",
      "tests": [
        "native/functions/argument-error-is-call-error",
        "native/functions/expand-argument-error-is-call-error"
      ]
    },
    {
      "id": "functions-call-result-is-value",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "A call's result is an ordinary value, so arithmetic, template interpolation, attribute access, indexing and splats apply to it",
      "tests": [
        "native/functions/call-result-attribute-access-evaluates",
        "native/functions/call-result-in-arithmetic",
        "native/functions/call-result-in-template",
        "native/functions/call-result-index-evaluates",
        "native/functions/call-result-splat-evaluates"
      ]
    },
    {
      "id": "functions-result-type-varies",
      "spec": "spec.md#functions-and-function-calls",
      "rule": "A function can return values of different types for arguments of different types",
      "tests": [
        "native/functions/result-type-depends-on-arguments"
      ]
    },
    {
      "id": "functions-expand-final-requires-sequence",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "An argument marked with an ellipsis must evaluate to a list or tuple: a string, number, object or map is an error",
      "tests": [
        "native/functions/expand-map-is-error",
        "native/functions/expand-number-is-error",
        "native/functions/expand-object-is-error",
        "native/functions/expand-string-is-error",
        "native/unknowns/function-expand-unknown-string-is-error"
      ]
    },
    {
      "id": "functions-expand-final-null",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "Expanding a null, the null keyword or a null list, is an error (disputed)",
      "tests": [
        "native/functions/expand-null-is-error",
        "native/functions/expand-null-list-is-error"
      ]
    },
    {
      "id": "functions-expand-final-set",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "An argument marked with an ellipsis can also be a set, whose elements become the arguments (disputed)",
      "tests": [
        "native/functions/expand-set-elements-become-arguments"
      ]
    },
    {
      "id": "functions-expand-final-maps-elements",
      "spec": "hclsyntax/spec.md#functions-and-function-calls",
      "rule": "The elements of the value of the whole final argument expression become separate arguments in order, mapped to the parameters after those taken by the earlier arguments and then to the variadic parameter; the elements keep their own types, an empty tuple adds no arguments, and an element that is itself a tuple is one argument",
      "tests": [
        "native/functions/expand-after-other-arguments",
        "native/functions/expand-applies-to-whole-final-expression",
        "native/functions/expand-elements-fill-positional-then-variadic",
        "native/functions/expand-tuple-elements-keep-their-types",
        "native/functions/expand-elements-into-variadic-parameter",
        "native/functions/expand-empty-tuple-after-arguments",
        "native/functions/expand-empty-tuple-gives-no-arguments",
        "native/functions/expand-list-elements-become-arguments",
        "native/functions/expand-nested-tuple-is-one-argument",
        "native/functions/expand-tuple-elements-become-arguments"
      ]
    },
    {
      "id": "functions-positional-parameters",
      "spec": "spec.md#functions-and-function-calls",
      "rule": "Arguments are mapped to a function's positional parameters in order, and each argument is checked against the type and the null, unknown and dynamic flags of its own parameter, positional or variadic",
      "tests": [
        "native/functions/positional-arguments-in-parameter-order",
        "native/functions/positional-arguments-out-of-order-is-error",
        "native/functions/positional-parameter-flags-follow-position",
        "native/functions/positional-parameter-null-flag-not-applied-to-variadic",
        "native/functions/variadic-parameter-null-flag-not-applied-to-positional",
        "native/unknowns/function-dynamic-flag-follows-position",
        "native/unknowns/function-positional-dynamic-flag-not-applied-to-variadic",
        "native/unknowns/function-positional-unknown-flag-not-applied-to-variadic",
        "native/unknowns/function-unknown-flag-follows-position",
        "native/unknowns/function-variadic-dynamic-flag-not-applied-to-positional",
        "native/unknowns/function-variadic-unknown-flag-not-applied-to-positional"
      ]
    },
    {
      "id": "functions-missing-arguments",
      "spec": "spec.md#functions-and-function-calls",
      "rule": "A call with fewer arguments than the function has positional parameters is an error, also when the function has a variadic parameter or the arguments come from an expanded tuple",
      "tests": [
        "native/functions/expand-too-few-elements-is-error",
        "native/functions/missing-argument-with-variadic-parameter-is-error",
        "native/functions/missing-last-argument-is-error",
        "native/functions/missing-only-argument-is-error"
      ]
    },
    {
      "id": "functions-variadic-parameter",
      "spec": "spec.md#functions-and-function-calls",
      "rule": "A function's variadic parameter collects all arguments left after the positional parameters, which may be none, and each of them is checked against the variadic parameter's type",
      "tests": [
        "native/functions/variadic-after-positional-arguments",
        "native/functions/variadic-argument-type-mismatch-is-error",
        "native/functions/variadic-empty-after-positional-arguments",
        "native/functions/variadic-several-arguments",
        "native/functions/variadic-without-arguments"
      ]
    },
    {
      "id": "functions-extra-arguments",
      "spec": "spec.md#functions-and-function-calls",
      "rule": "A call with more arguments than positional parameters is an error when the function has no variadic parameter, including a function without parameters and arguments from an expanded tuple",
      "tests": [
        "native/functions/expand-too-many-elements-is-error",
        "native/functions/extra-argument-is-error",
        "native/functions/extra-argument-without-parameters-is-error"
      ]
    },
    {
      "id": "functions-argument-type-mismatch",
      "spec": "spec.md#functions-and-function-calls",
      "rule": "A call is an error when an argument doesn't match its parameter's type specification, such as a tuple for a string, an object for a tuple, or a string such as yes for a bool",
      "tests": [
        "native/functions/argument-object-for-tuple-parameter-is-error",
        "native/functions/argument-string-for-bool-parameter-is-error",
        "native/functions/argument-tuple-for-string-parameter-is-error"
      ]
    },
    {
      "id": "functions-argument-conversion",
      "spec": "spec.md#functions-and-function-calls",
      "rule": "An argument that doesn't match its parameter's type is converted to that type by the conversion rules: between primitive types, tuples to lists and sets, lists to sets, objects to maps and to object types with fewer attributes, and the null keyword to a typed null, including variadic arguments and expanded elements (disputed)",
      "tests": [
        "native/functions/argument-bool-converts-to-string",
        "native/functions/argument-list-converts-to-set",
        "native/functions/argument-null-keyword-converts-to-typed-null",
        "native/functions/argument-number-converts-to-string",
        "native/functions/argument-object-converts-to-map",
        "native/functions/argument-object-drops-extra-attributes",
        "native/functions/argument-string-converts-to-bool",
        "native/functions/argument-string-converts-to-number",
        "native/functions/argument-tuple-converts-to-list",
        "native/functions/argument-tuple-converts-to-list-of-dynamic",
        "native/functions/argument-tuple-converts-to-set",
        "native/functions/expand-elements-each-converted",
        "native/functions/variadic-arguments-each-converted"
      ]
    },
    {
      "id": "functions-function-error",
      "spec": "spec.md#functions-and-function-calls",
      "rule": "A call is an error when the function it calls fails (disputed)",
      "tests": [
        "native/functions/function-error-is-eval-error"
      ]
    },
    {
      "id": "functions-literal-only-mode",
      "spec": "spec.md#expression-evaluation",
      "rule": "In literal-only evaluation mode no functions are available",
      "tests": [
        "native/functions/call-literal-only-mode-is-error"
      ]
    }
  ]
}
